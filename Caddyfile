(donatrack_routes) {
	handle /oauth2/* {
		reverse_proxy auth:8004
	}
	handle /login/oauth2/* {
		reverse_proxy auth:8004
	}
	handle {
		reverse_proxy web:8080
	}
}

(service_proxy) {
	handle_path {args[1]}/* {
		@public_docs path /v3/api-docs* /swagger-ui* /actuator/health /actuator/info /graphiql*
		handle @public_docs {
			reverse_proxy {args[0]} {
				header_up X-Forwarded-Prefix {args[1]}
				header_up X-Service-Key {$INTERNAL_API_KEY}
			}
		}
		handle {
			reverse_proxy {args[0]} {
				header_up X-Forwarded-Prefix {args[1]}
			}
		}
	}
}

(microservices_gateway) {
	import service_proxy donaciones:8000 /donaciones
	import service_proxy incentivos:8001 /incentivos
	import service_proxy logistica:8002 /logistica
	import service_proxy notificaciones:8003 /notificaciones
	import service_proxy auth:8004 /auth
}

http://163.176.254.178 {
	import donatrack_routes
}

163.176.254.178.nip.io {
	import donatrack_routes
}

www.{$PUBLIC_DOMAIN:donatrack.social} {
	redir https://{$PUBLIC_DOMAIN:donatrack.social}{uri} permanent
}

{$PUBLIC_DOMAIN:donatrack.social} {
	import donatrack_routes
}

dev.{$PUBLIC_DOMAIN:donatrack.social} {
	redir /donaciones /donaciones/swagger-ui/index.html
	redir /incentivos /incentivos/swagger-ui/index.html
	redir /logistica /logistica/swagger-ui/index.html
	redir /notificaciones /notificaciones/swagger-ui/index.html
	redir /auth /auth/swagger-ui/index.html

	import microservices_gateway

	handle {
		root * /srv/dev-portal
		file_server
	}
}

api.{$PUBLIC_DOMAIN:donatrack.social} {
	@cors_preflight method OPTIONS
	handle @cors_preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, Content-Type, X-Service-Key"
		respond "" 204
	}

	header Access-Control-Allow-Origin "*"
	header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
	header Access-Control-Allow-Headers "Authorization, Content-Type, X-Service-Key"

	@root path /
	handle @root {
		header Content-Type "application/json; charset=utf-8"
		respond `{"service":"DonaTrack API Gateway","status":"UP","docs":"https://dev.{$PUBLIC_DOMAIN:donatrack.social}","services":{"donaciones":"/donaciones","incentivos":"/incentivos","logistica":"/logistica","notificaciones":"/notificaciones","auth":"/auth"}}` 200
	}

	import microservices_gateway

	handle {
		header Content-Type "application/json; charset=utf-8"
		respond `{"status":404,"error":"Not Found","docs":"https://dev.{$PUBLIC_DOMAIN:donatrack.social}"}` 404
	}
}

grafana.{$PUBLIC_DOMAIN:donatrack.social} {
	reverse_proxy grafana:3000
}
