# ============================================================================
# DonaTrack - Configuración de Variables de Entorno (Plantilla)
#
# Para usar este archivo:
# 1. Copiá la plantilla: cp .env.template .env
# 2. Ajustá los valores según tu entorno
# ============================================================================

# Perfil de Spring: "local" (PostgreSQL Docker/Local) o "prod" (Supabase)
SPRING_PROFILES_ACTIVE=local

# URL de Logística en Producción (Render)
LOGISTICA_URL_REMOTA=
LOGISTICA_URL_REMOTA1=
LOGISTICA_URL_REMOTA2=

# Perfiles de Docker Compose: "local" (Postgres, Mongo, RabbitMQ, n8n)
COMPOSE_PROFILES=local

# ----------------------------------------------------------------------------
# Base de Datos Local (Docker PostgreSQL)
# ----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=donatrack
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ----------------------------------------------------------------------------
# Base de Datos Producción (Supabase)
# ----------------------------------------------------------------------------
SUPABASE_HOST=aws-1-us-east-1.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_USER=
SUPABASE_PASSWORD=
SUPABASE_S3_ID=
SUPABASE_S3_KEY=

# ----------------------------------------------------------------------------
# Base de Datos Documental Local (Docker MongoDB - Logística)
# ----------------------------------------------------------------------------
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=donatrack_logistica
MONGO_USERNAME=donatrack
MONGO_PASSWORD=donatrack
MONGO_AUTH_DB=admin

# ----------------------------------------------------------------------------
# Base de Datos Documental Producción (MongoDB Atlas - Logística)
# ----------------------------------------------------------------------------
MONGO_ATLAS_URI=
MONGO_ATLAS_DATABASE=donatrack_logistica

# ----------------------------------------------------------------------------
# RabbitMQ Local (Docker)
# ----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=donatrack
RABBITMQ_PASSWORD=donatrack
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_SSL_ENABLED=false
RABBITMQ_ENABLED=true

# ----------------------------------------------------------------------------
# RabbitMQ Producción (CloudAMQP)
# ----------------------------------------------------------------------------
CLOUDAMQP_HOST=jackal.rmq.cloudamqp.com
CLOUDAMQP_PORT=5671
CLOUDAMQP_USERNAME=
CLOUDAMQP_PASSWORD=
CLOUDAMQP_VIRTUAL_HOST=
CLOUDAMQP_SSL_ENABLED=true

# ----------------------------------------------------------------------------
# Seguridad, JWT & M2M Inter-Servicios
# ----------------------------------------------------------------------------
JWT_SECRET=
JWT_TTL_MINUTES=120
INTERNAL_API_KEY=
# En prod (SPRING_PROFILES_ACTIVE=prod) ServiceSecurityFilter se activa por defecto (true).
# En local se mantiene en false para permitir pruebas agiles sin cabecera X-Service-Key ni JWT.
DONATRACK_SECURITY_ENABLED=false

# ----------------------------------------------------------------------------
# URLs de Microservicios & Web SSR
# ----------------------------------------------------------------------------
WEB_URL=http://localhost:8080
AUTH_URL=http://localhost:8004
DONACIONES_URL=http://localhost:8000
INCENTIVOS_URL=http://localhost:8001
LOGISTICA_URL=http://localhost:8002
NOTIFICACIONES_URL=http://localhost:8003
N8N_URL=http://localhost:5678

# ----------------------------------------------------------------------------
# Discord & Twilio Secrets
# ----------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN_BASE64=
TWILIO_CONTENT_SID=
TWILIO_PHONE_NUMBER=

# ----------------------------------------------------------------------------
# SSO
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
