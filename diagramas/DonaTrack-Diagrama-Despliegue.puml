' }
' skinparam component {
'     BackgroundColor #FFFFFF
'     BorderColor #666666
' }
' skinparam linetype polyline

' node "Dispositivo del Usuario\n(Donante, Admin, Entidad)" as Cliente <<Client Device>> {
'     component "Navegador Web\n(Interfaz SPA / Landing Page)" as Frontend
' }

' node "Servidor de Aplicaciones\n(Host Backend)" as AppServer <<Web/App Server>> {
'     component "DonaTrack App\n(Aplicación Multimódulo Java)" as Backend {
'         artifact "Módulo Core\n(Personas, Roles, Donaciones)" as ModCore
'         artifact "Módulo Incentivos" as ModIncentivos
'         artifact "Módulo Logística" as ModLogistica
'         artifact "Módulo Notificaciones" as ModNotificaciones
'     }
' }

' node "Servidor de Automatización" as n8nServer <<Automation Engine>> {
'     component "Plataforma n8n" as n8n
' }

' node "Servidor de Base de Datos" as DBServer <<Database Server>> {
'     database "RDBMS (ej. PostgreSQL)" as DB {
'         artifact "Esquemas de DonaTrack" as Schemas
'     }
' }

' cloud "Servicios Externos (SaaS)" as CloudSaaS {
'     component "Twilio" as API_SMS <<SMS>>
'     component "SendGrid / SMTP" as API_Email <<Email>>
'     component "Meta API" as API_WA <<WhatsApp>>
'     component "Redes Sociales" as API_Social <<LinkedIn>>
' }

' ' --- Conexiones y Protocolos ---

' Frontend 0..> Backend : "HTTPS / API REST"

' ' Conexiones a Base de Datos
' ModCore 0..> Schemas : "JDBC / TCP (Puerto 5432)"
' ModIncentivos 0..> Schemas : "JDBC / TCP"
' ModLogistica 0..> Schemas : "JDBC / TCP"
' ModNotificaciones 0..> Schemas : "JDBC / TCP"

' ' Integraciones Externas (Notificaciones)
' ModNotificaciones 0..> API_SMS : "HTTPS"
' ModNotificaciones 0..> API_Email : "HTTPS"
' ModNotificaciones 0..> API_WA : "HTTPS"

' ' Integración con n8n (Incentivos)
' ModIncentivos 0..> n8n : "Webhook (Eventos: Insignias, Ranking)"
' n8n 0..> API_Social : "HTTPS (Publicación Automática)"
' n8n 0..> Backend : "HTTPS / API REST (Actualización)"


left to right direction

node "Servidor Frontend"{
    [App Front]
}

node "Computadora Personal"{
    [Navegador Web]
}


node "Servidor de Autenticacion"{
    [Servicio Autenticacion]
}

node "Servidor self-hosted n8n"{
    [n8n]
}

package Dominio{
    node "Servidor gestion Donantes"{
        [Servicio de Gestion de Donantes, Donaciones y Entidades Beneficiarias]
    }
    node "Servidor Logistica y Gestion de Camiones y Entregas"{
        [Servicio de Logistica y Gestion de Camiones y Entregas]
    }
    node "Servidor de Incentivos a Donantes y Misiones"{
        [Servicio de Incentivos a Donantes y Misiones]
    }
    node "Servidor de Notificaciones"{
        [Servicio de Notificaciones]
    }
}

package Persistencia{
    node "Servidor de Base de Datos"{
        [Motor de base de datos (MySQL)]
    }
}

package "Servicios Externos"{
    node "Servidor Mensajeria Externa"{
        [Mensajeria Externas]
    }
    node "Servidor Redes Sociales"{
        [Publicacion Redes Sociales]
    }
    node "Servidor Generador Imagenes"{
        [Generador Imagenes]
    }

}


' CONEXIONES
[Navegador Web] --> [App Front] : HTTPS
[App Front] --> [Servicio Autenticacion]
[App Front] --> [Servicio de Gestion de Donantes, Donaciones y Entidades Beneficiarias] : HTTPS-API REST
[App Front] --> [Servicio de Logistica y Gestion de Camiones y Entregas] : HTTPS-API REST
[App Front] --> [Servicio de Incentivos a Donantes y Misiones] : HTTPS-API REST
[App Front] --> [Servicio de Notificaciones] : HTTPS-API REST
[Servicio de Gestion de Donantes, Donaciones y Entidades Beneficiarias] --> [Motor de base de datos (MySQL)]
[Servicio de Logistica y Gestion de Camiones y Entregas] --> [Motor de base de datos (MySQL)]
[Servicio de Incentivos a Donantes y Misiones] --> [Motor de base de datos (MySQL)]
[Servicio de Notificaciones] --> [Motor de base de datos (MySQL)]

[Servicio de Incentivos a Donantes y Misiones] --> [n8n] : Webhook
[n8n] --> [Servicio de Incentivos a Donantes y Misiones] : API REST
[n8n] --> [Publicacion Redes Sociales] : HTTPS - API REST
[n8n] --> [Generador Imagenes] : HTTPS - API REST
[Servicio de Notificaciones] --> [Mensajeria Externas] : HTTPS - API REST

' API GATEWAY ENTRE FRONT Y BACK'
' API ENTRE BACK Y BD ¿?'
' Conexiones entre servicios -> Usan el gateway o se relacionan entre si'
' Servicios externes desde n8n'


@enduml