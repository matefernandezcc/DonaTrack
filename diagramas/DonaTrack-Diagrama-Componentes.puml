@startuml DonaTrack_Component_Diagram
skinparam componentStyle uml2
skinparam linetype ortho
skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #333333
}

' Interfaces expuestas hacia el exterior
interface "API REST (HTTPS)" as I_API

' Interfaz Frontend
component "Frontend SPA\n(Cliente Web/Móvil)" as Frontend

' --- BACKEND MULTIMÓDULO ---
package "DonaTrack Backend (Aplicación Multimódulo)" {
    
    component "Módulo Core\n(Gestión, Personas y Donaciones)" as ModCore
    component "Módulo de Incentivos" as ModIncentivos
    component "Módulo de Logística" as ModLogistica
    component "Módulo de Notificaciones" as ModNotificaciones

    ' Interfaces internas entre módulos (APIs internas o llamadas directas en monolito)
    interface "I_Notificaciones" as I_Notif
    interface "I_Logistica" as I_Log
    interface "I_Incentivos" as I_Inc
    
    ' Definición de provisión de interfaces internas
    ModNotificaciones -up- I_Notif
    ModLogistica -up- I_Log
    ModIncentivos -up- I_Inc
    
    ' Dependencias internas
    ModCore ..> I_Notif : <<uses>>
    ModCore ..> I_Log : <<uses>>
    ModCore ..> I_Inc : <<uses>>
    
    ' Exposición de la API hacia el exterior
    ModCore -up- I_API
    ModIncentivos -up- I_API
    ModLogistica -up- I_API
}

' --- SISTEMAS EXTERNOS ---
database "Base de Datos\n(PostgreSQL)" as DB {
    interface "JDBC / JPA" as I_DB
}

component "Servidor n8n\n(Automatización)" as n8n {
    interface "Webhooks" as I_Webhook
}

cloud "APIs Notificaciones\n(Twilio, SendGrid, Meta)" as SaaSNotif
cloud "APIs Redes Sociales\n(LinkedIn, X, IG)" as SaaSSocial

' --- CONEXIONES EXTERNAS ---

Frontend ..> I_API : <<consume>>

' Conexiones a BD
ModCore ..> I_DB
ModIncentivos ..> I_DB
ModLogistica ..> I_DB
ModNotificaciones ..> I_DB

' Integraciones n8n y Redes
ModIncentivos ..> I_Webhook : "Notifica insignia obtenida"
n8n ..> SaaSSocial : "Publica post automático"
n8n ..> I_API : "Actualiza estado en BD"

' Integraciones SaaS
ModNotificaciones ..> SaaSNotif : "Despacha SMS/WA/Email"

@enduml