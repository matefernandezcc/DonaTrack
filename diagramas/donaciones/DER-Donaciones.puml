@startuml DER-Donaciones
!theme plain
hide circle
skinparam linetype ortho

note as db_note
  **Esquema:** donaciones
  **Motor:** PostgreSQL
  **Estrategias ORM:**
  - Persona: JOINED
  - Rol: JOINED
  - Necesidad: SINGLE_TABLE
end note

entity "persona" as persona {
  * id : UUID [PK]
  --
  email : VARCHAR(255)
  contacto_correo : VARCHAR(255)
  contacto_telefono : VARCHAR(255)
  contacto_whatsapp : VARCHAR(255)
  contacto_medio_predeterminado : VARCHAR(50)
  direccion_calle : VARCHAR(255)
  direccion_altura : DOUBLE PRECISION
  direccion_localidad : VARCHAR(255)
  direccion_pais : VARCHAR(255)
  direccion_nacionalidad : VARCHAR(255)
  direccion_provincia : VARCHAR(255)
  direccion_cp : VARCHAR(50)
  direccion_latitud : DOUBLE PRECISION
  direccion_longitud : DOUBLE PRECISION
  doc_tipo : VARCHAR(50)
  doc_numero : VARCHAR(255)
}

entity "persona_humana" as persona_humana {
  * id : UUID [PK, FK -> persona.id]
  --
  nombre : VARCHAR(255)
  apellido : VARCHAR(255)
  edad : INTEGER
}

entity "persona_juridica" as persona_juridica {
  * id : UUID [PK, FK -> persona.id]
  --
  razon_social : VARCHAR(255)
  tipo : VARCHAR(50)
  rubro : VARCHAR(255)
}

entity "rol" as rol {
  * id : UUID [PK]
  --
  persona_id : UUID [FK]
  fecha_alta : DATE
  dtype : VARCHAR(31) <<Discriminator>>
}

entity "rol_donante" as rol_donante {
  * id : UUID [PK, FK -> rol.id]
}

entity "rol_representante" as rol_representante {
  * id : UUID [PK, FK -> rol.id]
  --
  cargo : VARCHAR(255)
  organizacion_id : UUID [FK -> persona_juridica.id]
}

entity "rol_beneficiario" as rol_beneficiario {
  * id : UUID [PK, FK -> rol.id]
  --
  correo_representante : VARCHAR(255)
}

entity "categoria" as categoria {
  * id : UUID [PK]
  --
  nombre : VARCHAR(255)
  descripcion : VARCHAR(255)
}

entity "subcategoria" as subcategoria {
  * id : UUID [PK]
  --
  categoria_id : UUID [FK]
  nombre : VARCHAR(255)
  descripcion : VARCHAR(255)
}

entity "donacion_original" as donacion_original {
  * id : UUID [PK]
  --
  donante_id : UUID [FK -> rol_donante.id]
  descripcion_general : TEXT
  fecha_recepcion : TIMESTAMP
  usuario_id : VARCHAR(255)
}

entity "donacion" as donacion {
  * id : UUID [PK]
  --
  donacion_original_id : UUID [FK]
  subcategoria_id : UUID [FK]
  necesidad_id : UUID [FK -> necesidad.id]
  periodo_id : UUID [FK -> periodo_necesidad.id]
  estado : VARCHAR(50)
  fecha_creacion : TIMESTAMP
}

entity "bien" as bien {
  * id : UUID [PK]
  --
  donacion_id : UUID [FK]
  descripcion : VARCHAR(255)
  cantidad : DOUBLE PRECISION
  unidad_medicion : VARCHAR(50)
  es_usado : BOOLEAN
  fecha_vencimiento : DATE
}

entity "foto" as foto {
  * id : UUID [PK]
  --
  bien_id : UUID [FK]
  descripcion : VARCHAR(255)
  url : VARCHAR(500)
}

entity "historial_estado" as historial_estado {
  * id : UUID [PK]
  --
  donacion_id : UUID [FK]
  estado : VARCHAR(50)
  fecha : TIMESTAMP
  observacion : TEXT
  usuario_id : VARCHAR(255)
}

entity "necesidad" as necesidad {
  * id : UUID [PK]
  --
  beneficiario_id : UUID [FK -> rol_beneficiario.id]
  subcategoria_id : UUID [FK]
  descripcion : TEXT
  fecha_solicitud : TIMESTAMP
  dtype : VARCHAR(31) <<Discriminator>>
  
  -- Para NecesidadExtraordinaria --
  estado : VARCHAR(50)
  cantidad_requerida : DOUBLE PRECISION
  
  -- Para NecesidadRecurrente --
  activa : BOOLEAN
  cantidad_objetivo : DOUBLE PRECISION
  tipo_periodo : VARCHAR(50)
}

entity "periodo_necesidad" as periodo_necesidad {
  * id : UUID [PK]
  --
  necesidad_id : UUID [FK -> necesidad.id]
  fecha_inicio : DATE
  fecha_fin : DATE
  estado : VARCHAR(50)
}

' Relaciones Personas y Roles
persona ||--|| persona_humana : "1:1"
persona ||--|| persona_juridica : "1:1"
persona ||--o{ rol : "1:N"

rol ||--|| rol_donante : "1:1"
rol ||--|| rol_representante : "1:1"
rol ||--|| rol_beneficiario : "1:1"

rol_representante }o--|| persona_juridica : "N:1"

' Relaciones Donaciones
rol_donante ||--o{ donacion_original : "1:N"
donacion_original ||--o{ donacion : "1:N"
donacion ||--|| subcategoria : "N:1"
donacion ||--o{ bien : "1:N"
donacion ||--o{ historial_estado : "1:N"
bien ||--o{ foto : "1:N"

' Relaciones Necesidades
rol_beneficiario ||--o{ necesidad : "1:N"
necesidad ||--|| subcategoria : "N:1"
necesidad ||--o{ periodo_necesidad : "1:N (si es Recurrente)"
donacion }o--|| necesidad : "N:1 (Extraordinaria)"
donacion }o--|| periodo_necesidad : "N:1 (Recurrente)"

' Categorias
categoria ||--o{ subcategoria : "1:N"

@enduml
