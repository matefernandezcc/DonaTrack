@startuml DonaTrack_Final_NoPackages
skinparam classAttributeIconSize 0
skinparam linetype ortho

' =====================================================
' CLASES
' =====================================================

abstract class Persona {
    - id: UUID
    - direccion: Direccion
    - Contacto: Contacto
    - roles: List<Rol>
    + agregarRol(rol: Rol)
    + validarRol(rol: Rol)
}

class Contacto {
    - correoElectronico: String
    - telefono: String
    - whatsapp: String
    - medioPreferido: MedioContacto
}

class PersonaHumana {
    - nombre: String
    - apellido: String
    - documento: DocumentoIdentidad
    - fechaNacimiento: Date
    - genero: String
}

class PersonaJuridica {
    - razonSocial: String
    - cuit: String
    - tipo: TipoJuridica
    - rubro: String
}

class DocumentoIdentidad {
    - tipo: TipoDocumento
    - numero: String
}

abstract class Rol {
    - fechaAlta: LocalDate
}

class Representante {
    - cargo: String
    - organizacion: PersonaJuridica
}

class Donante {
    - donacionesRealizadas: List<Donacion>
    - historialRecepciones: List<RecepcionDonacion>
}

class Beneficiario {
    - donacionesAsignadas: List<Donacion>
    - necesidadesDeclaradas: List<Necesidad>
    + registrarNecesidad(n: Necesidad)
    + confirmarRecepcion(d: Donacion, fotos: List<Foto>)
}

class Administrador {
    - DepositoAsignado: Deposito
    + registrarRecepcion(donante, bienes)
    + asignarDonacion(donacion, entidad)
}

class Direccion {
    - calle: String
    - altura: String
    - localidad: String
    - codigoPostal: String
    - coordenadas: Coordenada
    - Provincia: Provincia
    - Pais: Pais
}

class Coordenada {
    - latitud: double
    - longitud: double
}

class Provincia {
    - nombreProvincia: String
    - Pais: Pais
}

class Pais {
    - nombrePais: String
    - nacionalidad: String
}

class Deposito {
    - id: String
    - donacionesDisponibles: List<Donacion>
    - nombre: String
    - capacidadMaxima: Integer
    - direccion: Direccion
}

class RecepcionDonacion {
    - id: UUID
    - fechaRecepcion: LocalDate
    - donante: Donante
    - donacionesSegmentadas: List<Donacion>
    - registradoPor: Administrador
    + segmentarBienes(bienesBrutos: List<Bien>)
}

note right of RecepcionDonacion
Representa la carga física inicial.
De aquí nacen múltiples Donaciones
agrupadas por subcategoría y vencimiento.
end note

class Donacion {
    - id: UUID
    - subcategoria: Categoria
    - bienes: List<Bien>
    - fechaVencimiento: Date
    - estado: EstadoDonacion
    - entidadAsignada: Beneficiario
    - fotos: List<Foto>
    - historialEstados: List<HistorialEstado>
    + cambiarEstado(nuevoEstado, observacion, usuario)
    + estaVencida(): Boolean
}

class HistorialEstado {
    - estado: EstadoDonacion
    - fecha: LocalDate
    - observacion: String
    - usuario: Administrador
}

class Bien {
    - cantidad: Double
    - unidadMedida: String
    - descripcion: String
    - esUsado: Boolean
    - subcategoria: Categoria
    - fechaVencimiento: LocalDate
    - fotoOpcional: list<Foto>
}

class Categoria {
    - nombre: String
    - descripcion: String
    - subcategorias: List<Categoria>
    + esSubcategoriaDe(categoria): Boolean
}

class Foto {
    - url: String
    - descripcion: String
}

abstract class Necesidad {
    - id: UUID
    - descripcion: String
    - subcategoriaRequerida: Categoria
    - estado: EstadoNecesidad
    - donacionesAsignadas: List<Donacion>
    - fechaSolicitud: Date
    + asignarDonacion(d: Donacion)
    + estaCubierta(): Boolean
}

class NecesidadExtraordinaria {
    - cantidadRequerida: double
    + cantidadPendiente(): Decimal
}

class NecesidadRecurrente {
    - cantidadObjetivo: Decimal
    - periodo: String
}

class Notificacion {
    - id: UUID
    - mensaje: String
    - fechaEnvio: LocalDate
    - medio: MedioContacto
    - leida: Boolean
    + marcarComoLeida()
}

interface AsignacionStrategy {
    + recomendarEntidad(d: Donacion, necesidades: List<Necesidad>): Beneficiario
}

class PorPrioridad
class PorCercania

interface ImportadorStrategy {
    + importar(archivo: Archivo)
}

class ImportadorCSV {
    - registroPersonas: List<Persona>
    + buscarPorEmail(String email)
}

' =====================================================
' ENUMS
' =====================================================

enum TipoJuridica {
    GUBERNAMENTAL
    ONG
    EMPRESA
    INSTITUCION
}

enum MedioContacto {
    EMAIL
    TELEFONO
    WHATSAPP
}

enum TipoDocumento {
    DNI
    PASAPORTE
    CUIT
}

enum EstadoDonacion {
    PENDIENTE
    EN_DEPOSITO
    ASIGNADA
    ENTREGADA
    VENCIDA
}

enum EstadoNecesidad {
    PENDIENTE
    CUBIERTA
}

' =====================================================
' HERENCIA
' =====================================================

interface AsignarDonacionUseCase{
+ ejecutar(donacion, administrador)
}

PorPrioridad ..|> AsignacionStrategy
PorCercania ..|> AsignacionStrategy
ImportadorCSV ..|> ImportadorStrategy

' =====================================================
' RELACIONES
' =====================================================

PersonaHumana *-- DocumentoIdentidad
DocumentoIdentidad --> TipoDocumento
PersonaJuridica --> TipoJuridica

Persona *-- Contacto
Contacto --> MedioContacto

Persona o-- Rol
Persona --> Direccion
Persona o-- "0..*" Notificacion

Representante --> PersonaJuridica

Donante --> RecepcionDonacion
Beneficiario *-- Necesidad

Direccion --> Coordenada
Direccion --> Provincia
Provincia --> Pais

Deposito --> Direccion
RecepcionDonacion --> Deposito
RecepcionDonacion --> Administrador
RecepcionDonacion --> "1..*" Donacion : genera >

Donacion *-- HistorialEstado
Donacion o-- Bien
Donacion --> Categoria : agrupa por >
Donacion --> EstadoDonacion
Donacion --> Foto
Donacion --> Beneficiario : asignada a >

Bien --> Categoria
Bien --> Foto

HistorialEstado --> Administrador
HistorialEstado --> EstadoDonacion

Categoria --> Categoria

Necesidad --> Categoria
Necesidad --> EstadoNecesidad
Necesidad --> Donacion

Administrador ..> AsignacionStrategy : usa
Administrador ..> ImportadorStrategy : usa

Notificacion --> MedioContacto

@enduml