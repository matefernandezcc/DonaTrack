@startuml Donaciones
skinparam classAttributeIconSize 0
skinparam linetype ortho

' ====== IDENTIDAD Y ROLES ======
abstract class Persona {
    - id: UUID
    - nombre: String
    - email: String
    - telefono: String
    - whatsapp: String
    - direccion: Direccion
    - roles: List<Rol>
    - medioContactoPreferido: MedioContacto
    - mediosContacto: List<MedioContacto>
}

class PersonaHumana {
    - apellido: String
    - dni: String
    - fechaNacimiento: Date
    - genero: String
}

class PersonaJuridica {
    - razonSocial: String
    - cuit: String
    - tipo: TipoJuridica
    - rubro: String
}

abstract class Rol {
    - fechaAlta: Date
}

class Representante {
    - organizacion: PersonaJuridica
    - cargo: String
}

class Beneficiario {
    - necesidades: List<Necesidad>
}

class Donante {
    - donaciones: List<Donacion>
}

class Administrador {
    - estrategiaAsignacion: AsignacionStrategy
    - estrategiaImportador: ImportadorStrategy
    + asignarDonacion(donacion, necesidades)
    + verRanking()
    + registrarDonacion(bienes)
}

interface AsignacionStrategy {
    + recomendarNecesidades(donaciones, necesidades)
}

class PorPrioridad
class PorCercania

interface ImportadorStrategy {
    + importar(Archivo)
}

class ImportadorCSV

enum TipoJuridica {
    GUBERNAMENTAL
    ONG
    EMPRESA
    INSTITUCION
}

enum MedioContacto {
    EMAIL
    TELEFONO
    WHATSAPP
}



' ====== LOCALIZACION ======
class Direccion {
    - calle: String
    - altura: Decimal
    - localidad: String
    - pais: Pais
    - codigoPostal: String
    - coordenadas: Coordenada
}

class Coordenada {
    - latitud: Decimal
    - longitud: Decimal
}

class Deposito {
    - nombre: String
    - capacidadMaxima: Integer
    - direccion: Direccion
}

enum Pais {
    ARGENTINA
}


' ====== DONACION Y BIENES ======
class Donacion {
    - id: UUID
    - fechaRegistro: Date
    - fechaVencimiento: Date
    - descripcion: String
    - estado: EstadoDonacion
    - necesidad: Necesidad
    - bienes: List<Bien>
    - fotos: List<String>
    - estados: List<HistorialEstado>
    - registradoPor: Administrador
}

class Bien {
    - categoria: Categoria
    - cantidadDonada: Integer
    - descripcion: String
    - unidadMedida: String
    - fotoOpcional: String
    - esUsado: Boolean
}

class Categoria {
    - nombre: String
    - descripcion: String
    - subcategorias: List<Categoria>
}

class HistorialEstado {
    - estado: EstadoDonacion
    - fecha: Date
    - observacion: String
    - usuario: Administrador
}

enum EstadoDonacion {
    PENDIENTE
    EN_DEPOSITO
    ASIGNADA
    ENTREGADA
    VENCIDA
}


' ====== DOMINIO DONACIONES ======
abstract class Necesidad {
    - id: UUID
    - descripcion: String
    - categoria: Categoria
    - estado: EstadoNecesidad
    - cantRequerida: Integer
    - prioridad: Integer
    - donaciones: List<Donacion>
    - fechaSolicitud: Date
}

class NecesidadExtraordinaria {}

class NecesidadRecurrente {
    - periodo: String 
}

enum EstadoNecesidad {
    CUBIERTA
    PENDIENTE
}

class Notificacion {
    - id: UUID
    - mensaje: String
    - fechaEnvio: Date
    - medio: MedioContacto
    - leida: Boolean
}

Persona o-- Notificacion
Notificacion --> MedioContacto


' ====== RELACIONES ======

PersonaHumana -|> Persona
PersonaJuridica --|> Persona

Representante -- PersonaJuridica
Representante --up|> Rol
Donante --up|> Rol
Administrador --up|> Rol
Beneficiario --up|> Rol

Persona o-- Rol
Persona --> MedioContacto

PersonaJuridica -> TipoJuridica

Administrador --> ImportadorStrategy
Administrador --> AsignacionStrategy
Administrador ..> Necesidad

PorPrioridad ..up|> AsignacionStrategy
PorCercania ..up|> AsignacionStrategy

ImportadorCSV ..up|> ImportadorStrategy

Deposito --> Direccion
Direccion --> Pais
Direccion -- Coordenada
Persona --> Direccion

HistorialEstado -- Administrador
HistorialEstado --> EstadoDonacion

Bien --> Categoria
Categoria --> Categoria

Donacion -- Administrador
Donacion *- HistorialEstado
Donacion -- Necesidad
Donacion --> Deposito
Donacion --> EstadoDonacion
Donacion o-- Bien

Necesidad --> Categoria
Necesidad --> EstadoNecesidad
NecesidadExtraordinaria --|> Necesidad
NecesidadRecurrente --|> Necesidad

Donante --> Donacion
Beneficiario --> Necesidad

@enduml