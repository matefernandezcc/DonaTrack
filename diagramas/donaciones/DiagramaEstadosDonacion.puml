@startuml DiagramaEstadosDonacion.puml

[*] --> EN_DEPOSITO : Recepción y segmentación de bienes

state EN_DEPOSITO : donacion.recibirEnDeposito()
state ASIGNADA : donacion.asignar(Beneficiario)
state LISTA_PARA_ENTREGAR : donacion.planificarRuta()
state EN_TRASLADO : donacion.iniciarTraslado()
state ENTREGADA : donacion.entregar()
state ENTREGA_FALLIDA : donacion.fallarEntrega(justificacion)
state VENCIDA : donacion.marcarVencida()

EN_DEPOSITO --> ASIGNADA : Asignar a necesidad
EN_DEPOSITO --> VENCIDA : Bienes caducados (Auditoría)
ASIGNADA --> LISTA_PARA_ENTREGAR : Planificar ruta
LISTA_PARA_ENTREGAR --> EN_TRASLADO : Iniciar despacho / transporte
EN_TRASLADO --> ENTREGADA : Recepción confirmada exitosamente
EN_TRASLADO --> ENTREGA_FALLIDA : Falla en la entrega (justificación registrada)
ENTREGA_FALLIDA --> EN_DEPOSITO : Retorno de bienes a depósito

ENTREGADA --> [*]
VENCIDA --> [*]

@enduml
