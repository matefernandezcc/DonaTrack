@startuml DonaTrack-Diagrama-Clases.puml
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "Comunicacion Inter-Servicios" {
    class APIGateway <<REST>>
    class MessageBroker <<RabbitMQ>>
}

package "Servicio de Donaciones" {
    package "Gestión de Personas" {
        enum TipoDocumento {
            DNI
            CUIT
            PASAPORTE
        }

        class DocumentoIdentidad {
            - tipo: TipoDocumento
            - numero: String
        }

        DocumentoIdentidad --> TipoDocumento

        enum TipoJuridica {
            GUBERNAMENTAL
            ONG
            EMPRESA
            INSTITUCION
        }

        enum MedioContacto {
            CORREO
            TELEFONO
            WHATSAPP
        }

        abstract class Persona {
            - id: UUID
            - email: String
            - contacto: Contacto
            - direccion: Direccion
            - documento: DocumentoIdentidad
            - roles: List<Rol>
            + agregarRol(r: Rol): boolean
            # {abstract} validarRol(r: Rol): boolean
            + validar(validador: PersonaValidator): boolean
            + setDocumento(documento: DocumentoIdentidad): boolean
            + actualizarInformacion(datosNuevos: Map<String, Object>)
        }

        class Contacto {
            - correoElectronico: String
            - telefono: String
            - whatsapp: String
            - medioPredeterminado: MedioContacto
        }

        class Direccion {
            - calle: String
            - altura: Decimal
            - localidad: String
            - pais: Pais
            - codigoPostal: String
            - coordenadas: Coordenada
        }

        class Coordenada {
            - latitud: Decimal
            - longitud: Decimal
        }

        class Provincia{
            - nombreProvincia: String
            - Pais: Pais
        }

        class Pais {
            - nombrePais: String
            - nacionalidad: String
        }

        class PersonaHumana extends Persona {
            - nombre: String
            - apellido: String
            - edad: int
            # validarRol(r: Rol): boolean
            + actualizarInformacion(datosNuevos: Map<String, Object>)
        }

        note top of PersonaHumana
            **Regla de negocio:**
            Tira excepción de invalidez de
            rol si el rol es Beneficiario
            (acepta solo Donante,
            Representante o Administrador)
        end note

        class PersonaJuridica extends Persona {
            - razonSocial: String
            - tipo: TipoJuridica
            - representantes: List<Representante>
            - rubro: String
            + agregarRepresentante(r: Representante)
            # validarRol(r: Rol): boolean
            + actualizarInformacion(datosNuevos: Map<String, Object>)
        }

        note top of PersonaJuridica
            **Regla de negocio:**
            Tira excepción de
            invalidez de rol si el rol es
            Representante o Administrador
        end note

        'relaciones
        Direccion --> Provincia : "es de un"
        Provincia --> Pais : "forma parte de"
        Direccion --> Coordenada : "se encuentra"
        Persona --> Direccion : "tiene"
        Persona "1" *-- "1" Contacto : "tiene"
        Contacto --> MedioContacto : "define"
        Persona --> DocumentoIdentidad : "tiene"
        PersonaJuridica --> TipoJuridica : "se clasifica en"
    }

    package "Gestion de Roles" {
        abstract class Rol {
            - id: UUID
            - fechaAlta: LocalDate
            + {abstract} esValidoParaHumana(): boolean
            + {abstract} esValidoParaJuridica(): boolean
        }

        class Donante extends Rol {
            - donacionesRealizadas: List<Donacion>
            - historialRecepciones: List<RecepcionDonacion>
            + agregarDonacion(d: Donacion)
            + agregarRecepcion(r: RecepcionDonacion)
            + consultarEstadoDonacion(d: Donacion): EstadoDonacion
            + consultarEstadoTodasLasDonaciones(donacionesRealizadas: List<Donacion>): List<EstadoDonacion>
            + filtrarDonaciones(estado: EstadoDonacion, categoria: String)
            + verUbicacionCamion()
        }

        class Representante extends Rol {
            - cargo: String
            - organizacion: PersonaJuridica
        }

        class Beneficiario extends Rol {
            - donacionesAsignadas: List<Donacion>
            - necesidadesDeclaradas: List<Necesidad>
            + registrarNecesidad(n: Necesidad)
            + confirmarRecepcion(d: Donacion, fotosComprobante: List<Foto>): boolean
            + verEstadoDonaciones(donacionesAsignadas: List<Donacion>): List<EstadoDonacion>
            + verUbicacionCamion()
        }

        class Administrador extends Rol {
            - idDepositoAsignado: UUID
            - camionesIds: List<UUID>
            - estrategiaImportador: ImportadorStrategy
            + importarDonantesMasivos(rutaArchivo: String): boolean
            + asociarDonacion(d: Donacion, donante: Donante)
            + asignarDonacionFinal(d: Donacion, b: Beneficiario)
            + administrarCamiones()
            + verRankingMensual()
        }

        class CorreoRegistro {
            - Destinatario: String
            - mensaje: String
            - fechaEnvio: Date
        }

        interface AsignacionStrategy {
            + recomendarNecesidades(donaciones, necesidades)
        }

        class PorPrioridad
        class PorCercania

        interface ImportadorStrategy {
            + importar(Archivo)
        }

        class ImportadorCSV

        Administrador --> ImportadorStrategy
        Administrador --> AsignacionStrategy
        PorPrioridad ..up|> AsignacionStrategy
        PorCercania ..up|> AsignacionStrategy
        ImportadorCSV ..up|> ImportadorStrategy
        Administrador --> CorreoRegistro : "genera"
    }

    package "Gestion de Ingreso y Segmentación" {
        class RecepcionDonacion {
            - id: UUID
            - fechaRecepcion: Date
            - donante: Donante
            - donacionesSegmentadas: List<Donacion>
            - registradoPor: Administrador
            + segmentarBienes(bienesBrutos)
        }

        note left of RecepcionDonacion
            **Regla de negocio:**
            Representa la "única carga"
            física en el depósito. A partir
            de los bienes, se generan las
            Donaciones independientes.
        end note

        class Donacion {
            - id: UUID
            - estado: EstadoDonacion
            - bienes: List<Bien>
            - subCategoria: Subcategoria
            - historial: List<HistorialEstado>
            - fechaVencimiento: LocalDate
            - entidadAsignada: Beneficiario
            - fotos: List<Foto>
            + agregarBien(b: Bien)
            + registrarCambioEstado(nuevoRegistro: HistorialEstado)
            + cambiarEstado(nuevoEstado: EstadoDonacion, observacion: String, usuario: Administrador)
            + asignar(beneficiario: Beneficiario)
            + addFoto(foto: Foto)
            + getCategoriasString(): List<String>
        }

        enum EstadoDonacion {
            EN_DEPOSITO
            ASIGNADA
            LISTA_PARA_ENTREGAR
            EN_TRASLADO
            ENTREGADA
            ENTREGA_FALLIDA
            VENCIDA
        }

        class HistorialEstado {
            - Donacion: Donacion
            - estado: EstadoDonacion
            - fecha: Date
            - observacion: String
            - usuario: Administrador
        }

        class Bien {
            - descripcion: String
            - cantidad: double
            - unidadMedicion: String
            - esUsado: boolean
            - fechaVencimiento: LocalDate
            - foto: List<Foto>
        }

        class Categoria {
            - nombre: String
            - descripcion: String
            - subcategorias: List<Subcategoria>
            + agregarSubcategoria(Subcategoria)
        }

        class Subcategoria {
            - nombre: String
            - descripcion: String
            - categoriaPadre: Categoria
            + esSubcategoriaDe(categoria)
        }

        class Foto{
            - descripcion: String
            - Url: String
        }

        Bien --> Subcategoria
        Bien --> Foto
        Categoria --> Subcategoria
        Donacion *-- HistorialEstado
        Donacion "1" *-- "1..*" Bien : "agrupa"
        Donacion --> EstadoDonacion : "se encuentra en"
        RecepcionDonacion *-- Donacion : segmenta >
    }

    package "Gestion de Necesidades" {
        enum EstadoNecesidad {
            ABIERTA
            SATISFECHA
        }

        abstract class Necesidad {
            - descripcion: String
            - estado: EstadoNecesidad
            - subcategoriaRequerida: Subcategoria
            - id: UUID
            - fechaSolicitud: Date
            + estaCubierta(): Boolean
        }

        class NecesidadRecurrente extends Necesidad {
            - cantidadObjetivo: double
            - periodo: String
        }

        class NecesidadExtraordinaria extends Necesidad {
            - cantidadRequerida: double
            + acumularDonacionesParciales()
        }

        Necesidad --> EstadoNecesidad : "se encuentra en"
    }

    ' Gestión de Personas y Roles
    Persona "1" *--down--- "1..*" Rol : "asume"

    ' Conexiones de Dominio (Roles y Donaciones)
    Beneficiario "1" ---> "0..*" Donacion : "tiene asignadas"
    Donante "1" --> "0..*" Donacion : "realiza (asoc. por Admin)"
    Donacion -up-> Administrador : "es gestionada por"
    RecepcionDonacion --> Administrador
    Beneficiario "1" *--- "0..*" Necesidad : "declara"
    Necesidad "*" ---> "1" Subcategoria : "demanda"
    Necesidad "1" o-- "0..*" Donacion : "tiene"
}

package "Servicio de Incentivos" {

    enum CategoriaDonante {
        COLABORADOR
        SOSTENEDOR
        TRANSFORMADOR
        + {abstract} siguienteNivel(): CategoriaDonante
    }

    enum TipoMetricaMision {
        DONACIONES_EXITOSAS
        MAX_BIENES
        MESES_CONSECUTIVOS
        CATEGORIAS_DISTINTAS
        - unidad: String
        + {abstract} extraerValor(perfil: PerfilDonante): int
    }


    class PerfilDonante {
        - donanteId: UUID
        - categoria: CategoriaDonante
        - insigniasObtenidas: List<Insignia>
        - misionesPendientes: Queue<Mision>
        - misionActual: Mision
        - metricas: MetricasDonante
        + cargarMisionesDeCategoriaActual()
        + registrarDonacion(donacion: RegistroDonacion)
        + evaluarMisiones(mesActual: YearMonth)
    }

    class MetricasDonante {
        - donanteId : UUID
        - registrosDonacion: List<RegistroDonacion>
        - misionesCompletadas: Map<Mision, YearMonth>
        + totalDonacionesHistorias() : int
        + registrarDonacion(donacion: RegistroDonacion) : void
        + registrarMisionCompletada(mision: Mision, mes: YearMonth) : void
        + rachaDeMeses() : int
        + totalBienesDonados() : int
        + totalDonacionesExitosas() : int
        + maxBienesPorDonacion() : int
        + categoriasDonadas() : Set<String>
        + organizacionesBeneficiadas() : Set<UUID>
        + historialDonacionesPorMes() : Map<YearMonth, Integer>
        + ultimoMesDonacion() : YearMonth
        + misionesCompletadasPorMes() : Map<YearMonth, List<Mision>>
        + totalMisionesCompletadasEn(mes: YearMonth) : int
    }

    class RegistroDonacion {
        - idDonacion : UUID
        - cantidadBienes: int
        - categorias: Set<String>
        - idEntidadBeneficiaria: UUID
        - mesDonacion: YearMonth
        + esExitosa() : boolean
    }

    class Mision {
        - id: UUID
        - nombre: String
        - recompensa: Insignia
        - tipoMetrica: TipoMetricaMision
        - objetivo: int
        + evaluar(perfil: PerfilDonante): boolean
        + getProgresoActual(perfil: PerfilDonante): String
        - extraerValor(perfil: PerfilDonante): int
    }

    class Insignia {
        - id: UUID
        - nombre: String
        - descripcion: String
        - urlImagen: String
    }

    class InsigniaObtenidaEvent {
        - donanteId: UUID
        - insignia: Insignia
    }

    class MisionesFactory {
        + crearMisionesPara(categoria: CategoriaDonante): Queue<Mision>
    }

    class RankingMensualService {
        - puntuacionStrategy: RankingStrategy
        + obtenerTop3Mensual(mes: YearMonth): List<PerfilDonante>
    }

    interface RankingStrategy {
        + calcularPuntaje(perfil: PerfilDonante, mes: YearMonth): double
    }

    class RankingMisionesStrategy implements RankingStrategy {
        + calcularPuntaje(perfil: PerfilDonante, mes: YearMonth): double
    }



    ' Relaciones
    PerfilDonante "1" *-- "1" CategoriaDonante : nivel actual >
    PerfilDonante "1" *-- "0..*" Mision : pendientes >
    PerfilDonante "1" *-- "0..*" Insignia : posee >

    Mision --> Insignia : recompensa >
    Mision --> TipoMetricaMision : evalúa >
    PerfilDonante "1" *-- "1" MetricasDonante : delega métricas >
    PerfilDonante ..> RegistroDonacion : usa >
    MetricasDonante ..> RegistroDonacion : procesa >

    MisionesFactory ..> Mision : instancia >
    MisionesFactory ..> CategoriaDonante : usa >

    InsigniaObtenidaEvent --> Insignia : refiere >

    RankingMensualService --> RankingStrategy : utiliza >
    RankingStrategy ..> PerfilDonante : evalúa >
}

package "Servicio de Notificaciones" {

    class NotificadorService {
        - adaptadores: Map<String, NotificacionAdapter>
        + NotificadorService(adaptadores: Map<String, NotificacionAdapter>)
        + enviarNotificacion(destinatario: String, mensaje: String, medio: String)
    }

    enum TipoEvento {
        INACTIVIDAD_DONANTE
        DONACION_ASIGNADA_ENTIDAD
        DONACION_ASIGNADA_DONANTE
        MISION_CUMPLIDA
        CAMBIO_CATEGORIA
        INICIO_RUTA_LOGISTICA
    }

    class Evento {
        - tipoEvento: TipoEvento
        - descripcion: String
        - rolesDestinatarios: List<String>
        + validoParaNotificar(rol: String): boolean
    }

    class NotificacionFactory {
        + {static} crearNotificacion(evento: Evento, destinatario: String, mensaje: String): Notificacion
        + {static} crearNotificacion(evento: Evento, destinatario: String, mensaje: String, medio: String): Notificacion
    }

    class Notificacion {
        - destinatario: String
        - mensaje: String
        - fechaEnvio: LocalDateTime
        - completada: boolean
        - evento: Evento
        - medio: String
        + Notificacion(destinatario: String, mensaje: String)
        + Notificacion(destinatario: String, mensaje: String, evento: Evento, medio: String)
    }

    interface NotificacionAdapter {
        + enviar(notificacion: Notificacion)
    }

    class AdaptadorEmail implements NotificacionAdapter {
        + enviar(notificacion: Notificacion)
    }

    class AdaptadorSMS implements NotificacionAdapter {
        + enviar(notificacion: Notificacion)
    }

    class AdaptadorWhatsApp implements NotificacionAdapter {
        + enviar(notificacion: Notificacion)
    }

    ' Relaciones de Aplicacion y Adaptadores
    NotificadorService "1" *-- "0..*" NotificacionAdapter : "utiliza >"
    NotificadorService ..> Notificacion : "envía >"
    NotificacionFactory ..> Notificacion : "crea >"
    Notificacion --> Evento : "posee >"
    Evento --> TipoEvento : "posee >"
}

package "Servicio de Logistica" {
  package "Gestion Planificacion" {
    enum EstadoPlanificacion {
      PENDIENTE
      RECIBIDA
      PROCESADA
    }

    class SolicitudPlanificacion {
      - id: UUID
      - fechaSolicitud: LocalDateTime
      - estado: EstadoPlanificacion
      - idsDonaciones: List<UUID>
      + procesarCallback(rutas: List<RutaDeReparto>)
    }

    note right of SolicitudPlanificacion
      El proveedor externo procesa
      max. 100 donaciones por lote.
      Notifica resultado vía callback URL.
    end note

    class ItemPlanificacion <<Value Object>> {
      - idDonacionOriginal: UUID
      - pesoEstimado: Double
      - volumenEstimado: Double
    }
  }

  package "Gestion Reparto" {
    class Camion {
      - patente: String
      - capacidadVolumen: Double
      - altura: Double
      - capacidadCarga: Double
    }

    class Chofer {
      - legajo: String
      - nombre: String
    }

    class RutaDeReparto {
      - id: UUID
      - fechaOperativa: LocalDate
      - iniciada: Boolean
      + iniciarRuta()
    }

    class Parada {
      - orden: Integer
    }
  }

  package "Gestion Entregas" {
    enum EstadoEntrega {
      PENDIENTE
      EN_TRASLADO
      ENTREGADA
      NO_RECIBIDA
    }

    class Entrega {
      - idEntrega: UUID
      - estado: EstadoEntrega
      - pesoEstimado: Double
      - volumenEstimado: Double
      + marcarEnTraslado()
      + confirmarRecepcion(fotos: List<String>)
      + marcarNoRecibida()
      + volverAPendiente()
    }

    note right of Entrega
      idDonacionOriginal referencia
      al Servicio de Donaciones
      (contexto externo)
    end note

    class ComprobanteRecepcion {
      - fechaHora: LocalDateTime
      - fotos: List<String>
      - camionPatente: String
    }
  }

  class Direccion <<Value Object>> {
    - calle: String
    - altura: String
    - localidad: String
  }

  class Coordenada <<Value Object>> {
    - latitud: Double
    - longitud: Double
  }

  ' Relaciones con multiplicidades estrictas
  SolicitudPlanificacion "1" --> "0..*" RutaDeReparto : genera >
  RutaDeReparto "1" --> "1" Camion : asignada a >
  RutaDeReparto "1" --> "1" Chofer : conducida por >
  RutaDeReparto "1" *-- "1..*" Parada : compuesta por >

  Parada "1" *-- "1" Direccion : se ubica en >
  Parada "1" *-- "1" Coordenada : geolocalizada en >
  Parada "1" *-- "1..*" Entrega : contiene >

  Entrega "1" --> "1" EstadoEntrega : se encuentra en >
  Entrega "1" *-- "0..1" ComprobanteRecepcion : genera al entregar >
  SolicitudPlanificacion "1" --> "1" EstadoPlanificacion : se encuentra en >

  SolicitudPlanificacion "1" *-- "1..100" ItemPlanificacion : contiene >
  ItemPlanificacion "1" --> "1" Direccion : destino >
}

' ==========================================
' Conexiones entre Servicios (Infraestructura)
' ==========================================
"Servicio de Donaciones" ..> MessageBroker : Publica/Consume
"Servicio de Logistica" ..> MessageBroker : Publica/Consume
"Servicio de Incentivos" ..> MessageBroker : Consume
"Servicio de Notificaciones" ..> MessageBroker : Consume

"Servicio de Donaciones" ..> APIGateway : API REST
"Servicio de Logistica" ..> APIGateway : API REST
"Servicio de Incentivos" ..> APIGateway : API REST

@enduml