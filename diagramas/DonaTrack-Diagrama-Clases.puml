@startuml DonaTrack-Diagrama-Clases.puml
skinparam classAttributeIconSize 0
skinparam linetype ortho

package ConexionPorFuera{
    class ConeccionIngresoInicial{}
}

package "servicio de donaciones"{
    package "Gestión de Personas" {
        enum TipoDocumento {
            DNI
            CUIT
            PASAPORTE
        }

        enum TipoPersonaJuridica {
            GUBERNAMENTAL
            ONG
            EMPRESA
            INSTITUCION
        }

        enum MedioContacto {
            CORREO
            TELEFONO
            WHATSAPP
        }

        package validadorDatosPersona{
            class DocumentoIdentidad {
                - tipo: TipoDocumento
                - numero: String
            }

            abstract class Persona {
                - id: UUID
                - email: String
                - contacto: Contacto
                - direccion: Direccion
                - documento: DocumentoIdentidad
                - roles: List<Rol>
                + agregarRol(Rol r)
                + validarRol(Rol r)
                + validarDocumentacion(DocumentoIdentidad d)
                + setDocumento(DocumentoIdentidad documento)
                + actualizarInformacion(Map<String, Object> datosNuevos)
            }

            class Contacto {
                - correoElectronico: String
                - telefono: String
                - whatsapp: String
                - medioPredeterminado: MedioContacto
            }

            
        class PersonaHumana extends Persona {
            - nombre: String
            - apellido: String
            - edad: int
            + validarRol(r: Rol)
            + validarDocumentacion(DocumentoIdentidad d)
            + actualizarInformacion(Map<String, Object> datosNuevos)
        }

        note top of PersonaHumana
        **Regla de negocio:**
        Tira excepción de invalidez de 
        rol si el rol es Beneficiario 
        (acepta solo Donante,
        Representante o Administrador)
        end note

        class PersonaJuridica extends Persona {
            - razonSocial: String
            - tipo: TipoPersonaJuridica
            - representantes: List<Representante>
            - rubro: String
            + agregarRepresentante(Representante r)
            + validarRol(Rol r)
            + validarDocumentacion(DocumentoIdentidad d)
            + actualizarInformacion(Map<String, Object> datosNuevos)
        }

        note top of PersonaJuridica
        **Regla de negocio:**
        Tira excepción de 
        invalidez de rol si el rol es 
        Representante o Administrador
        end note

        'relaciones
        Persona "1" *-- "1" Contacto : "tiene"
        Contacto --> MedioContacto : "define"
        Persona --> DocumentoIdentidad : "tiene"
        PersonaJuridica --> TipoPersonaJuridica : "se clasifica en"
        DocumentoIdentidad --> TipoDocumento
        }

        package Ubicacion{
            class Direccion {
            - calle: String
            - altura: Decimal
            - localidad: String
            - pais: Pais
            - codigoPostal: String
            - coordenadas: Coordenada
            }

            class Coordenada {
                - latitud: Decimal
                - longitud: Decimal
            }

            class Provincia{
                - nombreProvincia: String
                - Pais: Pais
            }

            class Pais {
                - nombrePais: String
                - nacionalidad: String
            }

            Direccion --> Provincia : "es de un"
            Provincia --> Pais : "forma parte de"
            Direccion --> Coordenada : "se encuentra"
        }

        Persona --> Direccion : "tiene"
    }

    package "Gestion de Roles" {
        abstract class Rol {
            - fechaAlta: LocalDate
        }

        class Donante extends Rol {
            - donacionesRealizadas: List<Donacion>
            - historialRecepciones: List<RecepcionDonacion>
            + agregarDonacion(Donacion d)
            + agregarRecepcion(RecepcionDonacion r)
            + consultarEstadoDonacion(Donacion d)
            + filtrarDonaciones(estado: EstadoDonacion, categoria: String)
            + UbicacionCamion()
        }

        class Representante extends Rol {
            - cargo: String
            - organizacion: PersonaJuridica
        }

        class Beneficiario extends Rol {
            - donacionesAsignadas: List<Donacion>
            - necesidadesDeclaradas: List<Necesidad>
            - correoRepresentante: String
            + registrarNecesidad(n: Necesidad)
            + confirmarRecepcion(d: Donacion, fotos: List<String>)
            + EstadoDonaciones()
            + UbicacionCamion()
        }

        class Administrador extends Rol {
            - estrategiaAsignacion: AsignacionStrategy
            - estrategiaImportador: ImportadorStrategy
            + importarDonantesMasivos(String rutaArchivo)
            + obtenerRecomendacionAsignacion(List<Donacion> donacionesDisponibles, List<Necesidad> necesidadesDeclaradas)
            + asociarDonacion(d: Donacion, p: Persona)
            + actualizarDonacionesVencidas()
            + asignarDonacionFinal(d: Donacion, e: Beneficiario)
            + administrarCamiones()
            + RankingMensual()
        }

        class CorreoRegistro {
            - Destinatario: String
            - mensaje: String
            - fechaEnvio: Date
        }

        package StrategyAdministrador{

            package asignador{
                interface AlgoritmoAsignacion {
                    + recomendarNecesidades(donaciones, necesidades)
                }
                
                class PrioridadASubAtendidos implements AlgoritmoAsignacion
                class CompatibilidadSemantica implements AlgoritmoAsignacion
            }

            package importador{
                interface ImportadorStrategy {
                    + importar(Archivo)
                }

                class ImportadorCSV implements ImportadorStrategy
            }     
        }

        Administrador --> ImportadorStrategy
        Administrador --> AlgoritmoAsignacion
        Administrador --> CorreoRegistro : "genera"
    }

    package "Gestion de Ingreso y Segmentación" {
        class RecepcionDonacion {
            - id: UUID
            - fechaRecepcion: Date
            - donante: Donante
            - donacionesSegmentadas: List<Donacion>
            - registradoPor: Administrador
        }

        class SegmentadorDeBienes {
            - bienesBrutos : List<Bien>
            - estrategiasSegmentacion : List<estrategiaSegmentacion>
            - donacionesResultantes : List<Donacion>
            + procesar(bienesBrutos)
        }

        note left of SegmentadorDeBienes 
        *Regla de negocio:*
        A partir de la "carga única" 
        de bienes, se generan las 
        Donaciones independientes.
        end note

        note left of RecepcionDonacion 
        **Regla de negocio:**
        Representa la "única carga" 
        física en el depósito. A partir 
        de los bienes, se generan las 
        Donaciones independientes.
        end note

        class Donacion {
            - id: UUID
            - fechaCreacion: Date
            - estado: EstadoDonacion
            - bienes: List<Bien>
            - categoria: Categoria
        }

    package Segmentacion{
        interface EstrategiaSegmentacion{
            +segmentar(List<List<Bien>> bienes)
        } 

        class segmentarPorEstado implements EstrategiaSegmentacion{
            +segmentar(List<List<Bien>> listasDeBienes)
        }
        
        class SegmentarPorSubcategoria implements EstrategiaSegmentacion{
            + segmentar(List<List<Bien>> listasDeBienes)
        }

        class SegmentarPorVencimiento implements EstrategiaSegmentacion{
            + segmentar(List<List<Bien>> listasDeBienes)
        }
    }

    package Estado{
        enum EstadoDonacion {
            PENDIENTE
            ASIGNADA
            ENTREGADA
            EN_DEPOSITO
            VENCIDA
        }

        abstract class EstadoDonacionState{
            + asignar(Beneficiario beneficiario)
            + planificarRuta()
            + iniciarTraslado()
            + entregar()
            + fallarEntrega(String justificacion)
            + marcarVencida()
            + recibirEnDeposito()
        }

        class Asignada implements EstadoDonacionState{
            + planificarRuta()
            + EstadoDonacion getValorEnum()
        }

        class Endeposito implements EstadoDonacionState{
            + asignar(Beneficiario beneficiario)
            + marcarVencida()
            + getValorEnum()
        }

        class EnTraslado implements EstadoDonacionState{
            + entregar()
            + fallarEntrega(String justificacion)
            + getValorEnum()
        }

        class EntregaFallida implements EstadoDonacionState{
            + recibirEnDeposito()
            + getValorEnum()
        }

        class Entregada implements EstadoDonacionState{
            + getValorEnum()
        }

        class ListaParaEntregar implements EstadoDonacionState{
            + iniciarTraslado()
            + getValorEnum()
        }

        class Vencida implements EstadoDonacionState{
            + getValorEnum()
        }

        class HistorialEstado {
            - Donacion: Donacion
            - estado: EstadoDonacion
            - fecha: Date
            - observacion: String
            - usuario: Administrador
        }
    }

        class Bien {
            - descripcion: String
            - cantidad: double
            - unidadMedicion: String
            - esUsado: boolean
            - fechaVencimiento: LocalDate
            - foto: List<Foto>
        }

        class Categoria {
            - nombre: String
            - descripcion: String
            - subcategorias: List<Categoria>
            + agregarSubcategoria(categoria)
            + esSubcategoriaDe(categoria)
        }

        class Foto{
            - descripcion: String
            - Url: String
        }

        Bien --> Categoria
        Bien --> Foto
        Categoria --> Categoria

        Donacion *-- HistorialEstado
        Donacion "1" *-- "1..*" Bien : "agrupa"
        Donacion --> EstadoDonacion : "se encuentra en"
        Donacion --> EstadoDonacionState : "se encuentra en"

        RecepcionDonacion --> Donante

        SegmentadorDeBienes *-- Donacion : segmenta >
        SegmentadorDeBienes -- EstrategiaSegmentacion : usa >
    }

    package "Gestion de Necesidades" {
        enum EstadoNecesidad {
            ABIERTA
            SATISFECHA
        }

        abstract class Necesidad {
            - descripcion: String
            - estado: EstadoNecesidad
            - subcategoriaRequerida: Categoria
            - id: UUID
            - fechaSolicitud: Date
            + estaCubierta(): Boolean
        }

        class NecesidadRecurrente implements Necesidad {
            - cantidadObjetivo: double
            - periodo: String
        }

        class NecesidadExtraordinaria implements Necesidad {
            - cantidadRequerida: double
            + acumularDonacionesParciales()
        }

        Necesidad --> EstadoNecesidad : "se encuentra en"
    }
}

package "Servicio de Incentivos" {
    enum CategoriaDonante {
        COLABORADOR
        SOSTENEDOR
        TRANSFORMADOR
    }

    interface CategoriaDonanteState {
        + avanzarCategoria()
        + getValorEnum(): CategoriaDonante
    }

    class ColaboradorState implements CategoriaDonanteState {
        - perfil: PerfilDonante
        + avanzarCategoria()
        + getValorEnum(): CategoriaDonante
    }

    class SostenedorState implements CategoriaDonanteState {
        - perfil: PerfilDonante
        + avanzarCategoria()
        + getValorEnum(): CategoriaDonante
    }

    class TransformadorState implements CategoriaDonanteState {
        - perfil: PerfilDonante
        + avanzarCategoria()
        + getValorEnum(): CategoriaDonante
    }

    class PerfilDonante {
        - donanteId: UUID
        - categoria: CategoriaDonanteState
        - insigniasObtenidas: List<Insignia>
        - misionesPorNivel: MisionesPorNivel
        - misionActual: Mision
        - totalDonacionesHistoricas: int
        - mesesConsecutivosDonando: int
        - cantidadBienesDonados: int
        - donacionesExitosas: int
        - maxBienesEnUnaDonacion: int
        - categoriasUnicasDonadas: Set<String>
        - organizacionesUnicasAyudadas: Set<UUID>
        - historialDonacionesPorMes: Map<YearMonth, Integer>
        - ultimoMesDonacion: YearMonth
        + PerfilDonante(donanteId: UUID)
        + cargarMisionesDeCategoriaActual()
        + registrarDonacionExitosa(actividad: ActividadDonacionDTO)
        + evaluarMisiones()
        + getMisionesActivas(): List<Mision>
    }

    abstract class MisionesPorNivel {
        # misiones: List<Mision>
        # misionActual: Mision
        # perfilAsociado: PerfilDonante
        # categoriaObtener: CategoriaDonante
        # fechaAsignacion: LocalDate
        + {abstract} clonar(): MisionesPorNivel
        + avanzarMision(): Mision
    }

    class MisionesPorNivelColaborador extends MisionesPorNivel {
        + MisionesPorNivelColaborador()
        + clonar(): MisionesPorNivel
    }

    class MisionesPorNivelSostenedor extends MisionesPorNivel {
        + MisionesPorNivelSostenedor()
        + clonar(): MisionesPorNivel
    }

    class MisionesPorNivelTransformador extends MisionesPorNivel {
        + MisionesPorNivelTransformador()
        + clonar(): MisionesPorNivel
    }

    abstract class Mision {
        - nombre: String
        - recompensa: Insignia
        + Mision(nombre: String, recompensa: Insignia)
        + {abstract} evaluar(perfil: PerfilDonante): boolean
        + {abstract} getProgresoActual(perfil: PerfilDonante): String
    }

    class RachaMision extends Mision {
        - mesesObjetivo: int
        + evaluar(perfil: PerfilDonante): boolean
        + getProgresoActual(perfil: PerfilDonante): String
    }

    class CompletitudMision extends Mision {
        - categoriasObjetivo: int
        + evaluar(perfil: PerfilDonante): boolean
        + getProgresoActual(perfil: PerfilDonante): String
    }

    class HabilDonadorMision extends Mision {
        - cantidadMinimaBienes: int
        + evaluar(perfil: PerfilDonante): boolean
        + getProgresoActual(perfil: PerfilDonante): String
    }

    class DonacionesExitosasMision extends Mision {
        - donacionesObjetivo: int
        + evaluar(perfil: PerfilDonante): boolean
        + getProgresoActual(perfil: PerfilDonante): String
    }

    class Insignia {
        - nombre: String
        - descripcion: String
        - fechaObtencion: LocalDate
        - visiblePublicamente: boolean
        + setVisible(visible: boolean)
    }

    class RankingMensualService {
        - repository: PerfilDonanteRepository
        - puntuacionStrategy: RankingPuntuacionStrategy
        + RankingMensualService(repository: PerfilDonanteRepository, puntuacionStrategy: RankingPuntuacionStrategy)
        + obtenerTop5Mensual(): List<PerfilDonante>
    }

    interface RankingPuntuacionStrategy {
        + calcularPuntaje(perfil: PerfilDonante): double
    }

    class RankingPorDonacionesStrategy implements RankingPuntuacionStrategy {
        + calcularPuntaje(perfil: PerfilDonante): double
    }

    interface PerfilDonanteRepository {
        + findAll(): List<PerfilDonante>
    }
}

package "Servicio de Notificaciones" {
    class NotificadorService {
        - adaptadores: Map<String, NotificacionAdapter>
        + NotificadorService(adaptadores: Map<String, NotificacionAdapter>)
        + enviarNotificacion(destinatario: String, mensaje: String, medio: String)
    }

    enum TipoEvento {
        INACTIVIDAD_DONANTE
        DONACION_ASIGNADA_ENTIDAD
        DONACION_ASIGNADA_DONANTE
        MISION_CUMPLIDA
        CAMBIO_CATEGORIA
    }

    class Evento {
        - tipoEvento: TipoEvento
        - descripcion: String
        - rolesDestinatarios: List<String>
        + validoParaNotificar(rol: String): boolean
    }

    class NotificacionFactory {
        + {static} crearNotificacion(evento: Evento, destinatario: String, mensaje: String): Notificacion
        + {static} crearNotificacion(evento: Evento, destinatario: String, mensaje: String, medio: String): Notificacion
    }

    class Notificacion {
        - destinatario: String
        - mensaje: String
        - fechaEnvio: LocalDateTime
        - completada: boolean
        - evento: Evento
        - medio: String
        + Notificacion(destinatario: String, mensaje: String)
        + Notificacion(destinatario: String, mensaje: String, evento: Evento, medio: String)
    }

    interface NotificacionAdapter {
        + enviar(notificacion: Notificacion)
    }

    class AdaptadorEmail implements NotificacionAdapter {
        + enviar(notificacion: Notificacion)
    }

    class AdaptadorSMS implements NotificacionAdapter {
        + enviar(notificacion: Notificacion)
    }

    class AdaptadorWhatsApp implements NotificacionAdapter {
        + enviar(notificacion: Notificacion)
    }
}

' --- CONEXIONES ARQUITECTÓNICAS ENTRE PAQUETES ---

' Gestión de Personas y Roles
Persona "1" *--down--- "1..*" Rol : "asume"

' Conexiones de Dominio (Roles y Donaciones)
Beneficiario "1" ---> "0..*" Donacion : "tiene asignadas"
Donante "1" --> "0..*" Donacion : "realiza (asoc. por Admin)"
Donacion -up-> Administrador : "es gestionada por"
RecepcionDonacion --> Administrador
Beneficiario "1" *--- "0..*" Necesidad : "declara"
Necesidad "*" ---> "1" Categoria : "demanda"
Necesidad "1" o-- "0..*" Donacion : "tiene"

' Conexiones Servicio de Incentivos
Donante "1" --> "1" PerfilDonante : "tiene asociado"
PerfilDonante "1" *-- "1" CategoriaDonanteState : posee >
PerfilDonante "1" *-- "1" MisionesPorNivel : debe completar >
PerfilDonante "1" *-- "0..*" Insignia : posee >

MisionesPorNivel "1" *-- "0..*" Mision : contiene >
MisionesPorNivel --> CategoriaDonante : Objetivo >
Mision --> Insignia : recompensa >

RankingMensualService --> PerfilDonanteRepository : consulta >
RankingMensualService --> RankingPuntuacionStrategy : utiliza >
RankingPuntuacionStrategy ..> PerfilDonante : evalúa >

' Conexiones Servicio de Notificaciones
NotificadorService --> NotificacionAdapter : utiliza >
NotificadorService ..> Notificacion : envía >
NotificacionFactory ..> Notificacion : crea >
Notificacion --> Evento : posee >
Evento --> TipoEvento : posee >

@enduml


