@startuml DonaTrack_Diagrama_De_Componentes_Y_Despliegue_Entrega5
left to right direction
skinparam componentStyle uml2
skinparam nodesep 25
skinparam ranksep 60

' Colores
skinparam node {
    BackgroundColor #AED6F1
    BorderColor #5D6D7E
}
skinparam component {
    BackgroundColor #FADBD8
    BorderColor #5D6D7E
}
skinparam interface {
    BackgroundColor #FFFFFF
    BorderColor #5D6D7E
    FontSize 11
}
skinparam rectangle {
    BorderColor #5D6D7E
    FontStyle bold
}

node "Servidor Frontend" as N_Frontend {
    component "Frontend SPA\n(Cliente Web/Móvil)" as Frontend
}

rectangle "API Gateway" #line.dashed {
    node "Servidor API" as N_API {
        component "API REST (HTTPS)" as ModuloAPI
    }
}

' ----- BACKEND MultiServicio (MicroServidores) -----
rectangle "Dominio (DonaTrack Backend)" #line.dashed {
    node "Servidor de Donaciones\n:8000" as N_Donaciones {
        component "Servicio de Donaciones" as ModDonaciones
        component "Broker de Logística\n(LogisticaBrokerAdapter)" as BrokerLogistica
        
        ModDonaciones ..> BrokerLogistica : usa
    }
    node "Servidor de Incentivos\n:8001" as N_Incentivos {
        component "Servicio de Incentivos" as ModIncentivos
    }
    
    node "Servidor de Logística (Local - Fallback)\n:8002" as N_Logistica_Local {
        component "Servicio de Logística" as ModLogisticaLocal
    }
    
    node "Servidor de Notificaciones\n:8003" as N_Notificaciones {
        component "Servicio de Notificaciones" as ModNotificaciones
    }
}

' Nodos de Nube para Logistica Principal (2 Instancias)
rectangle "Despliegue en la Nube (Render)" #line.dashed {
    node "Servidor en Nube (Render - Instancia 1)" as N_Logistica_Nube1 {
        component "Servicio de Logística\n(Instancia 1)" as ModLogisticaNube1
    }
    node "Servidor en Nube (Render - Instancia 2)" as N_Logistica_Nube2 {
        component "Servicio de Logística\n(Instancia 2)" as ModLogisticaNube2
    }
}

' ========================================================
' PERFILES DE PERSISTENCIA Y MENSAJERÍA (Verticales)
' ========================================================
rectangle "Profile: local" as ProfileLocal #line.dashed {
    () "Mongo :27017" as Port_Mongo_Local
    () "AMQP :5672" as Port_AMQP_Local
    () "JPA :5432" as Port_JPA_Local

    node "Docker MongoDB\n:27017" as N_Mongo_Local {
        component "MongoDB Local\n(donatrack_logistica)" as Mongo_Local
    }
    node "Docker RabbitMQ\n:5672/:15672" as N_BrokerMQ_Local {
        component "RabbitMQ Local" as RabbitMQ_Local
    }
    node "Docker PostgreSQL\n:5432" as N_DB_Local {
        component "PostgreSQL Local\n(schemas: donaciones, incentivos, notif)" as DB_Local
    }
    
    Port_Mongo_Local ----(0---- Mongo_Local
    Port_AMQP_Local ----(0---- RabbitMQ_Local
    Port_JPA_Local ----(0---- DB_Local
    
    ' Alineación vertical de puertos (Mongo arriba, AMQP medio, JPA abajo)
    Port_Mongo_Local -[hidden]left-> Port_AMQP_Local
    Port_AMQP_Local -[hidden]left-> Port_JPA_Local

    ' Alineación vertical de servidores (Mongo arriba, RabbitMQ medio, PostgreSQL abajo)
    N_Mongo_Local -[hidden]left-> N_BrokerMQ_Local
    N_BrokerMQ_Local -[hidden]left-> N_DB_Local
}

rectangle "Profile: prod" as ProfileProd #line.dashed {
    () "Mongo Atlas" as Port_Mongo_Cloud
    () "AMQP CloudAMQP" as Port_AMQP_Cloud
    () "JPA Supabase" as Port_JPA_Cloud

    node "MongoDB Atlas\n(donatrack.ofn4ag4)" as N_Mongo_Cloud {
        component "MongoDB Atlas Cluster\n(donatrack_logistica)" as Mongo_Cloud
    }
    node "CloudAMQP\n(jackal.rmq.cloudamqp.com)" as N_BrokerMQ_Cloud {
        component "CloudAMQP (RabbitMQ)" as RabbitMQ_Cloud
    }
    node "Supabase PostgreSQL\n(AWS us-east-1)" as N_DB_Cloud {
        component "PostgreSQL Supabase\n(schemas: donaciones, incentivos, notif)" as DB_Cloud
    }
    
    Port_Mongo_Cloud ----(0---- Mongo_Cloud
    Port_AMQP_Cloud ----(0---- RabbitMQ_Cloud
    Port_JPA_Cloud ----(0---- DB_Cloud
    
    ' Alineación vertical de puertos (Mongo arriba, AMQP medio, JPA abajo)
    Port_Mongo_Cloud -[hidden]left-> Port_AMQP_Cloud
    Port_AMQP_Cloud -[hidden]left-> Port_JPA_Cloud

    ' Alineación vertical de servidores (Mongo arriba, CloudAMQP medio, Supabase abajo)
    N_Mongo_Cloud -[hidden]left-> N_BrokerMQ_Cloud
    N_BrokerMQ_Cloud -[hidden]left-> N_DB_Cloud
}

ProfileLocal -[hidden]left-> ProfileProd

node "Servidor de n8n" as N_n8n {
    component "Servidor n8n\n(Automatización)" as n8n
}

node "Servidores de APIs 1....N" as N_SaaSNotif {
    component "APIs Notificaciones\n(Twilio, SendGrid, Meta)" as SaaSNotif
}

node "Servidor de Planificación Externo" as N_Planificador {
    component "Motor de Rutas (Simulado)" as PlanificadorExterno
}

' ==========================================
' CONEXIONES (Ball-and-Socket: ----(0----)
' ==========================================

' 0. Conexiones Frontend y API Gateway
Frontend ----(0---- ModuloAPI : "HTTPS (Consume)"
ModuloAPI ----(0---- ModDonaciones : "HTTP / API REST"
ModuloAPI ----(0---- ModIncentivos : "HTTP / API REST"
ModuloAPI ----(0---- ModLogisticaLocal : "HTTP / API REST"
ModuloAPI ----(0---- ModLogisticaNube1 : "HTTP / API REST"
ModuloAPI ----(0---- ModLogisticaNube2 : "HTTP / API REST"
ModuloAPI ----(0---- ModNotificaciones : "HTTP / API REST"

' 1. Conexiones Profile: local unificadas en puertos
ModDonaciones ----(0---- Port_JPA_Local
ModIncentivos ----(0---- Port_JPA_Local
ModNotificaciones ----(0---- Port_JPA_Local

ModDonaciones ----(0---- Port_AMQP_Local
ModIncentivos ----(0---- Port_AMQP_Local
ModNotificaciones ----(0---- Port_AMQP_Local
ModLogisticaLocal ----(0---- Port_AMQP_Local

ModLogisticaLocal ----(0---- Port_Mongo_Local

' 2. Conexiones Profile: prod unificadas en puertos
ModDonaciones ----(0---- Port_JPA_Cloud
ModIncentivos ----(0---- Port_JPA_Cloud
ModNotificaciones ----(0---- Port_JPA_Cloud

ModDonaciones ----(0---- Port_AMQP_Cloud
ModIncentivos ----(0---- Port_AMQP_Cloud
ModNotificaciones ----(0---- Port_AMQP_Cloud
ModLogisticaLocal ----(0---- Port_AMQP_Cloud
ModLogisticaNube1 ----(0---- Port_AMQP_Cloud
ModLogisticaNube2 ----(0---- Port_AMQP_Cloud

ModLogisticaLocal ----(0---- Port_Mongo_Cloud
ModLogisticaNube1 ----(0---- Port_Mongo_Cloud
ModLogisticaNube2 ----(0---- Port_Mongo_Cloud

' 3. Broker de Logística (Feign Clients)
BrokerLogistica ----(0---- ModLogisticaNube1 : "HTTP POST (Prioridad 1)"
BrokerLogistica ----(0---- ModLogisticaNube2 : "HTTP POST (Prioridad 2)"
BrokerLogistica ----(0---- ModLogisticaLocal : "HTTP POST (Fallback Local)"

' 4. Planificador Externo (Callback)
ModLogisticaNube1 ----(0---- PlanificadorExterno : "HTTP POST (Solicitud)"
ModLogisticaNube2 ----(0---- PlanificadorExterno : "HTTP POST (Solicitud)"
PlanificadorExterno ----(0---- ModuloAPI : "HTTP POST (Callback)"
ModLogisticaLocal ----(0---- PlanificadorExterno : "HTTP POST (Solicitud)"

' 5. Integraciones n8n y Redes
ModIncentivos ----(0---- n8n : "POST Webhook"
ModNotificaciones ----(0---- n8n : "POST Webhook (Notificación)"
n8n ----(0---- ModuloAPI : "PATCH / PUT"
n8n ----(0---- SaaSNotif : "Despacha SMS/WA/Email"

@enduml