@startuml DER-Logistica-MongoDB
!pragma layout smetana
hide circle
skinparam linetype ortho

note as db_note
  **Base de Datos:** donatrack_logistica
  **Motor:** MongoDB (NoSQL Documental)
  **Estrategia:** Desnormalización y Documentos Embebidos (Agregado Raíz)
end note

' ========================================================
' COLECCIÓN AGREGADO RAÍZ: rutas_reparto
' ========================================================
entity "rutas_reparto (Colección Principal)" as RutasReparto {
  * **_id : UUID** <<Index>>
  --
  fechaOperativa : DATE <<Index>>
  iniciada : BOOLEAN
  .. Desnormalización Camión (Snapshot Histórico O(1)) ..
  camionId : UUID
  camionPatente : VARCHAR
  camionCapacidadVolumen : DOUBLE
  camionAltura : DOUBLE
  camionCapacidadCarga : DOUBLE
  .. Desnormalización Chofer (Snapshot Histórico O(1)) ..
  choferId : UUID <<Index>>
  choferLegajo : VARCHAR
  choferNombre : VARCHAR
  .. Subdocumentos Embebidos ..
  paradas : Array<ParadaDocument>
}

' ========================================================
' SUBDOCUMENTOS EMBEBIDOS (Dentro de rutas_reparto)
' ========================================================
entity "ParadaDocument <<Embedded>>" as ParadaDoc {
  orden : INTEGER
  direccion : DireccionDocument
  coordenada : CoordenadaDocument
  entregas : Array<EntregaDocument>
}

entity "DireccionDocument <<Embedded>>" as DireccionDoc {
  calle : VARCHAR
  altura : VARCHAR
  localidad : VARCHAR
}

entity "CoordenadaDocument <<Embedded>>" as CoordenadaDoc {
  latitud : DOUBLE
  longitud : DOUBLE
}

entity "EntregaDocument <<Embedded>>" as EntregaDoc {
  * **idEntrega : UUID** <<CompoundIndex>>
  estado : VARCHAR (PENDIENTE | EN_TRASLADO | ENTREGADA | NO_RECIBIDA)
  pesoEstimado : DOUBLE
  volumenEstimado : DOUBLE
  comprobanteRecepcion : ComprobanteRecepcionDocument
}

entity "ComprobanteRecepcionDocument <<Embedded>>" as ComprobanteDoc {
  fechaHora : TIMESTAMP
  fotos : Array<VARCHAR>
  camionPatente : VARCHAR
}

' ========================================================
' OTRAS COLECCIONES DOCUMENTALES
' ========================================================
entity "camiones (Colección)" as Camiones {
  * **_id : UUID**
  --
  patente : VARCHAR <<Unique Index>>
  capacidadVolumen : DOUBLE
  altura : DOUBLE
  capacidadCarga : DOUBLE
}

entity "choferes (Colección)" as Choferes {
  * **_id : UUID**
  --
  legajo : VARCHAR <<Unique Index>>
  nombre : VARCHAR
}

entity "items_planificacion (Colección)" as ItemsPlanificacion {
  * **_id : UUID**
  --
  idDonacionOriginal : UUID
  pesoEstimado : DOUBLE
  volumenEstimado : DOUBLE
  destino : DireccionDocument
}

entity "solicitudes_planificacion (Colección)" as SolicitudesPlanificacion {
  * **_id : UUID**
  --
  fechaSolicitud : TIMESTAMP
  estado : VARCHAR (PENDIENTE | RECIBIDA | PROCESADA)
  idsDonaciones : Array<UUID>
}

' Relaciones de Embebido y Referencias
RutasReparto *-- ParadaDoc : "embebido (1..*)"
ParadaDoc *-- DireccionDoc : "embebido"
ParadaDoc *-- CoordenadaDoc : "embebido"
ParadaDoc *-- EntregaDoc : "embebido (1..*)"
EntregaDoc *-- ComprobanteDoc : "embebido (0..1)"

ItemsPlanificacion *-- DireccionDoc : "embebido"

RutasReparto ..> Camiones : "referencia desnormalizada"
RutasReparto ..> Choferes : "referencia desnormalizada"
SolicitudesPlanificacion ..> RutasReparto : "genera"
SolicitudesPlanificacion ..> ItemsPlanificacion : "procesa"

@enduml