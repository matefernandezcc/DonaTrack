# ============================================================================
# DonaTrack - Configuración de Variables de Entorno (Plantilla)
#
# Para usar este archivo:
# 1. Copiá la plantilla: cp .env.example .env
# 2. Ajustá los valores según tu entorno
# ============================================================================

# Perfil de Spring: "local" (PostgreSQL Docker/Local) o "prod" (Supabase)
SPRING_PROFILES_ACTIVE=local

# ----------------------------------------------------------------------------
# Base de Datos Local (Docker PostgreSQL)
# ----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=donatrack
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ----------------------------------------------------------------------------
# Base de Datos Producción (Supabase)
# ----------------------------------------------------------------------------
SUPABASE_HOST={HOSTNAME}
SUPABASE_PORT=5432
SUPABASE_USER=postgres.{ID}
SUPABASE_PASSWORD=postgres

# ----------------------------------------------------------------------------
# RabbitMQ (Broker de Mensajería)
# ----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=donatrack
RABBITMQ_PASSWORD=donatrack
