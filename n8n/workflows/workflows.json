        "id": "donatrack-ranking",
        "name": "DonaTrack - Ranking",
        "description": null,
        "active": true,
        "isArchived": false,
        "nodes": [
            {
                "parameters": {
                    "rule": {
                        "interval": [
                            {
                                "field": "cronExpression",
                                "expression": "0 10 1 * *"
                            }
                        ]
                    }
                },
                "type": "n8n-nodes-base.scheduleTrigger",
                "typeVersion": 1.1,
                "position": [
                    0,
                    208
                ],
                "id": "schedule-node",
                "name": "Schedule Trigger"
            },
            {
                "parameters": {
                    "jsCode": "return [\n  { json: { user: 'Juan', donations: 5 } },\n  { json: { user: 'Maria', donations: 12 } },\n  { json: { user: 'Pedro', donations: 3 } },\n  { json: { user: 'Ana', donations: 8 } },\n  { json: { user: 'Luis', donations: 1 } },\n  { json: { user: 'Juan', donations: 2 } },\n  { json: { user: 'Ana', donations: 4 } }\n];"
                },
                "type": "n8n-nodes-base.code",
                "typeVersion": 2,
                "position": [
                    208,
                    208
                ],
                "id": "mock-data-node",
                "name": "Mock Data Source"
            },
            {
                "parameters": {
                    "jsCode": "const items = $input.all();\nconst totals = {};\n\nfor (const item of items) {\n  const user = item.json.user;\n  const donations = item.json.donations;\n  if (!totals[user]) totals[user] = 0;\n  totals[user] += donations;\n}\n\nconst ranking = Object.keys(totals).map(user => ({\n  user: user,\n  totalDonations: totals[user]\n}));\n\nranking.sort((a, b) => b.totalDonations - a.totalDonations);\n\nreturn ranking.map(r => ({ json: r }));"
                },
                "type": "n8n-nodes-base.code",
                "typeVersion": 2,
                "position": [
                    400,
                    208
                ],
                "id": "calculate-ranking-node",
                "name": "Calculate Ranking"
            },
            {
                "parameters": {
                    "method": "POST",
                    "url": "https://httpbin.org/post",
                    "sendBody": true,
                    "specifyBody": "json",
                    "jsonBody": "={{ JSON.stringify($input.all().map(i => i.json)) }}",
                    "options": {}
                },
                "type": "n8n-nodes-base.httpRequest",
                "typeVersion": 4.2,
                "position": [
                    608,
                    208
                ],
                "id": "persist-results-node",
                "name": "Persist Results (Mock API)"
            },
            {
                "parameters": {
                    "operation": "limit"
                },
                "type": "n8n-nodes-base.itemLists",
                "typeVersion": 3,
                "position": [
                    800,
                    208
                ],
                "id": "filter-top-3-node",
                "name": "Filter Top 3"
            },
            {
                "parameters": {
                    "jsCode": "const items = $(\"Calculate Ranking\").all().slice(0, 3);\nconst medals = ['\\u{1F947}', '\\u{1F948}', '\\u{1F949}']; // 🥇 🥈 🥉\nlet message = '\\u{1F4E2} ¡Ranking Mensual de DonaTrack! \\u{1F4E2}\\n\\n';\n\nfor (let i = 0; i < items.length; i++) {\n  const user = items[i].json.user;\n  const donations = items[i].json.totalDonations;\n  message += `${medals[i] || ''} ${i + 1}º Lugar: ${user} con ${donations} donaciones.\\n`;\n}\n\nmessage += '\\n¡Gracias a todos por su solidaridad!';\n\nreturn [{ json: { content: message } }];"
                },
                "type": "n8n-nodes-base.code",
                "typeVersion": 2,
                "position": [
                    1008,
                    208
                ],
                "id": "format-message-node",
                "name": "Format Podium Message"
            },
            {
                "parameters": {
                    "method": "POST",
                    "url": "https://discord.com/api/webhooks/1545253873785118740/fQ46oGTgcP5UZbcZmiVL7JIUblz71AUCVjzIDq7WnXYTCR-kT217cPlgGdNiGWnGm6jR",
                    "sendBody": true,
                    "bodyParameters": {
                        "parameters": [
                            {
                                "name": "content",
                                "value": "=={{ $json.content }}"
                            }
                        ]
                    },
                    "options": {}
                },
                "type": "n8n-nodes-base.httpRequest",
                "typeVersion": 4.2,
                "position": [
                    1200,
                    208
                ],
                "id": "publish-discord-node",
                "name": "Publish to Discord Webhook"
            }
        ],
        "connections": {
            "Schedule Trigger": {
