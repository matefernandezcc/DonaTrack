                    880
                ],
                "parameters": {
                    "assignments": {
                        "assignments": [
                            {
                                "name": "respuesta",
                                "type": "string",
                                "value": "<h4 style=\"margin-top: 0; color: var(--orange);\">📍 Dónde y Cuándo</h4><p>Los horarios de entrega se coordinan directamente con la sede que elijas al momento de hacer la donación.</p><a href=\"#mapa\" style=\"display: inline-block; margin-top: 10px; padding: 8px 12px; background-color: var(--blue); color: #fff; text-decoration: none; border-radius: 5px; font-weight: bold;\">🗺️ Ver mapa de sedes</a>"
                            }
                        ]
                    }
                }
            }
