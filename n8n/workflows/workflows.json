                    "jsCode": "// Obtenemos los datos que nos pasó el Webhook (¡agregamos .body al final!)\nconst datos = $input.item.json.body;\n\n// Armamos el texto para la red social\nconst mensajePublicable = `¡Felicidades a ${datos.user}! 🎉 Acaba de obtener la insignia \"${datos.badge}\" por su compromiso con DonaTrack. ${datos.description}. ¡Sumate vos también a ayudar!`;\n\n// Retornamos el nuevo mensaje\nreturn {\n  json: {\n    mensajeRedes: mensajePublicable\n  }\n};"
