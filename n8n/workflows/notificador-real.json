                                         "jsCode":  "const input = $input.all();\nreturn input.map(item =\u003e {\n  const body = item.json.body || item.json;\n  const destinatario = body.destinatario || body.user || body.to || \u0027General\u0027;\n  const mensaje = body.mensaje || body.message || body.description || \u0027Notificación sin mensaje\u0027;\n  let medio = (body.medio || body.channel || \u0027DISCORD\u0027).toUpperCase();\n  if (medio === \u0027CORREO\u0027) medio = \u0027EMAIL\u0027;\n  if (medio === \u0027TELEFONO\u0027) medio = \u0027SMS\u0027;\n\n  return {\n    json: {\n      destinatario: destinatario,\n      mensaje: mensaje,\n      medio: medio,\n      discordPayload: body.discordPayload\n    }\n  };\n});"
                                     },
